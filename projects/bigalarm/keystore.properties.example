# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Create a key once with:
#   keytool -genkeypair -v -keystore bigalarm.jks -alias bigalarm -keyalg RSA -keysize 2048 -validity 10000
storeFile=bigalarm.jks
storePassword=changeme
keyAlias=bigalarm
keyPassword=changeme
